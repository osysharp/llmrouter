// Osysharp.LlmRouter — a real routing policy for an app that declares more than one model: capability filters, a
// quality floor per kind of work, and the cheapest model that clears them.
//
// It asks for nothing. A router is a pure decision — no egress, no secret, no data — which is why it can be a package
// with an empty grant list and still be the thing that decides where every one of an app's model calls goes.
package Osysharp.LlmRouter {
  version     "0.1.0";
  minPlatform "0.9.0";
  summary     "a cost-tiered model router: hard capability filters, a quality floor per task kind, then cheapest-admissible.";

  model "model/*.osy";
  use Osysharp.Llm;
}
